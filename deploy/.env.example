# Copy to deploy/.env and fill in. Never commit deploy/.env (it is in .gitignore).
# Note: Docker env files don't allow comments on the same line as a value.

# ===== AI (required for the analysis; without it you get a headlines-only brief) =====
ANTHROPIC_API_KEY=
# anthropic | openai
INTEL_PROVIDER=anthropic
# claude-sonnet-5-5 (default) or claude-haiku-5-5 (much cheaper, less depth)
INTEL_MODEL=claude-sonnet-5-5
# low | medium | high: more thinking = better analysis and higher cost
INTEL_EFFORT=medium
# hard stop for one brief's AI spending, in USD
INTEL_MAX_DAILY_COST_USD=3
# only if INTEL_PROVIDER=openai:
# OPENAI_API_KEY=
# INTEL_OPENAI_MODEL=gpt-5

# ===== Telegram (delivery and commands) =====
# from @BotFather
TELEGRAM_BOT_TOKEN=
# your numeric id (ask @userinfobot); the bot answers nobody else
TELEGRAM_CHAT_ID=
# 1 = push every section each morning (long); 0 = summary + CEO brief + link
INTEL_TELEGRAM_FULL=0

# ===== Who builds the 6 am brief (use ONE producer) =====
# off = GitHub builds it (recommended, already running) and this server answers commands
# on  = this server builds and sends it
INTEL_SCHEDULE=off
# server start time in Eastern time, only used when INTEL_SCHEDULE=on (ready by about 6:00)
INTEL_BRIEF_TIME=05:40
INTEL_PUBLIC_URL=https://becharamezannar-eng.github.io/breakout-scanner/intel/

# ===== Optional =====
# NewsAPI paid plan (the free plan is for development only)
# NEWSAPI_KEY=
INTEL_LOOKBACK_HOURS=30
INTEL_MAX_VERIFY=420

# ===== Database (used by docker-compose) =====
POSTGRES_PASSWORD=change-me-to-a-long-random-string
